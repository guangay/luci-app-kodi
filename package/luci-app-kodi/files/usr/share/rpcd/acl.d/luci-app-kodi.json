{
	"luci-app-kodi": {
		"description": "Grant access to Kodi service status and control",
		"read": {
		"ubus": {
			"luci": [ "getInitList" ],
			"service": [ "list" ]
		},
			"uci": [ "kodi" ],
			"file": {
				"/proc/mounts": [ "read" ],
				"/etc/TZ": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"luci": [ "setInitAction" ],
				"uci": [ "set", "commit" ]
			},
			"uci": [ "kodi" ]
		}
	}
}
